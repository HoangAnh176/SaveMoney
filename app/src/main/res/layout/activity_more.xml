<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout android:id="@+id/ll_top_bar" android:layout_width="match_parent" android:layout_height="56dp" app:layout_constraintTop_toTopOf="parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Khác"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="48dp"
            android:textColor="#333333"/>

<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Trợ giúp"-->
<!--            android:textColor="#FF9800"-->
<!--            android:textSize="16sp"-->
<!--            android:paddingEnd="16dp"/>-->
    </LinearLayout>

    <View
        android:id="@+id/div_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/div_top"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:id="@+id/btn_personal_page"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_secure" app:tint="#FF9800"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Cài đặt hồ sơ" android:textSize="16sp" android:textColor="#333333" android:layout_marginStart="16dp"/>

                    <!-- Đã sửa TextView ">" thành ImageView ic_next -->
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_next" app:tint="#BDBDBD"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:elevation="2dp">

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginStart="56dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginStart="56dp"/>
                <LinearLayout
                    android:id="@+id/btn_fixed_transaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="#FF9800"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Chi phí cố định và thu nhập định kỳ" android:textSize="16sp" android:textColor="#333333" android:layout_marginStart="16dp"/>

                    <!-- Đã sửa TextView ">" thành ImageView ic_next -->
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_next" app:tint="#BDBDBD"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3 -->

            <!-- Card 4 -->

            <!-- Card 5 -->

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/div_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"/>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>